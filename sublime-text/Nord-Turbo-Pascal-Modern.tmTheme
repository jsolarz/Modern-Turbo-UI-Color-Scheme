<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>Nord Turbo Pascal Modern</string>
	<key>settings</key>
	<array>
		<dict>
			<key>settings</key>
			<dict>
				<key>background</key>
				<string>#252b36</string>
				<key>caret</key>
				<string>#FFD75F</string>
				<key>foreground</key>
				<string>#ECEFF4</string>
				<key>invisibles</key>
				<string>#4C566A</string>
				<key>lineHighlight</key>
				<string>#3b4252</string>
