{
  "name": "Nord Turbo Pascal Modern",
  "colors": {
    "editor.background": "#252b36",
    "editor.foreground": "#ECEFF4",
    "editor.lineHighlightBackground": "#3b4252",
    "editor.selectionBackground": "#2E4A7F",
    "editorCursor.foreground": "#FFD75F",
    "editorLineNumber.foreground": "#8492A6",
    "editorWhitespace.foreground": "#4C566A"
  },
  "tokenColors": [
    {
      "name": "Keywords",
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#ECEFF4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": ["variable", "variable.other", "variable.parameter", "entity.name.variable"],
      "settings": {
        "foreground": "#ECEFF4"
      }
    },
    {
      "name": "Readonly constants",
      "scope": ["variable.other.constant", "variable.constant"],
      "settings": {
        "foreground": "#D48AD8"
      }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function"],
      "settings": {
        "foreground": "#FFD75F"
      }
    },
    {
      "name": "Types",
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": {
        "foreground": "#FFD75F"
      }
    },
    {
      "name": "Properties",
      "scope": ["variable.other.property", "variable.other.member", "entity.name.property"],
      "settings": {
        "foreground": "#ECEFF4"
      }
    },
    {
      "name": "Strings",
      "scope": ["string"],
      "settings": {
        "foreground": "#88C0D0"
      }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#E5F6FF"
      }
    },
    {
      "name": "Constants",
      "scope": ["constant.language", "constant.character", "constant.other"],
      "settings": {
        "foreground": "#D48AD8"
      }
    },
    {
      "name": "String escapes",
      "scope": ["constant.character.escape"],
      "settings": {
        "foreground": "#ECEFF4"
      }
    },
    {
      "name": "String escapes",
      "scope": ["constant.character.escape"],
      "settings": {
        "foreground": "#ECEFF4"
      }
    },
    {
      "name": "Comments",
      "scope": ["comment"],
      "settings": {
        "foreground": "#8492A6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Directives and macros",
      "scope": ["meta.preprocessor", "keyword.control.directive", "punctuation.definition.directive", "entity.name.function.preprocessor"],
      "settings": {
        "foreground": "#FF5C57"
      }
    },
    {
      "name": "Invalid code",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#AA0000"
      }
    }
  ]
}
