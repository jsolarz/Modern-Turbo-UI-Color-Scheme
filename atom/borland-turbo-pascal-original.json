{
  "name": "Borland Turbo Pascal Original",
  "colors": {
    "editor.background": "#0000AA",
    "editor.foreground": "#AAAAAA",
    "editor.lineHighlightBackground": "#0000CC",
    "editor.selectionBackground": "#5555AA",
    "editorCursor.foreground": "#FFFFFF",
    "editorLineNumber.foreground": "#8888AA",
    "editorWhitespace.foreground": "#000088"
  },
  "tokenColors": [
    {
      "name": "Keywords",
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#FFFFFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Identifiers",
      "scope": ["variable", "variable.parameter", "variable.other.property", "variable.other.member"],
      "settings": {
        "foreground": "#AAAAAA"
      }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function"],
      "settings": {
        "foreground": "#FFFF00"
      }
    },
    {
      "name": "Types",
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": {
        "foreground": "#FFFF00"
      }
    },
    {
      "name": "Strings",
      "scope": ["string"],
      "settings": {
        "foreground": "#00FFFF"
      }
    },
    {
      "name": "String escapes",
      "scope": ["constant.character.escape"],
      "settings": {
        "foreground": "#55FFFF"
      }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#FF00FF"
      }
    },
    {
      "name": "Constants",
      "scope": ["constant.language", "constant.character", "variable.constant"],
      "settings": {
        "foreground": "#FF00FF"
      }
    },
    {
      "name": "Comments",
      "scope": ["comment"],
      "settings": {
        "foreground": "#00FF00"
      }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#FFFF00"
      }
    },
    {
      "name": "Directives",
      "scope": ["meta.preprocessor", "keyword.control.directive", "punctuation.definition.directive", "entity.name.function.preprocessor"],
      "settings": {
        "foreground": "#FF0000"
      }
    },
    {
      "name": "HTML tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": {
        "foreground": "#FF0000"
      }
    },
    {
      "name": "HTML attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#FFAA00"
      }
    },
    {
      "name": "Invalid code",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#AA0000"
      }
    }
  ]
}
